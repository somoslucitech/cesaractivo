# Cache de los archivos estaticos (Cloudflare Workers Static Assets).
# Los nombres no llevan hash, asi que no se marcan "immutable": un dia de
# cache fresca y una semana sirviendo la copia vieja mientras se revalida.
# Si se reemplaza un video o una foto, como mucho tarda un dia en verse.
/videos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/photos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/favicon/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
